{
  "name": "vscode-book-reader",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "lindacong",
  "version": "1.4.6",
  "icon": "renderer/public/logo.png",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/jinhuan138/vscode-book-reader.git",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "keywords": [
    "reader",
    "ebooks",
    "slack off",
    "epub",
    "mobi",
    "pdf",
    "azw3",
    "fk8",
    "cbz",
    "fb2"
  ],
  "homepage": "https://jinhuan138.github.io/vscode-book-reader",
  "bugs": "https://github.com/jinhuan138/vscode-book-reader/issues",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "book-reader.openFile",
        "title": "%command.openFile%"
      },
      {
        "command": "book-reader.openBook",
        "title": "%command.openBook%"
      },
      {
        "command": "book-reader.selectBookFolder",
        "title": "%command.selectBookFolder%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "book-reader.openBookInSidebar",
        "title": "%command.openBookInSidebar%",
        "icon": "$(open-preview)"
      },
      {
        "command": "book-reader.toggleSidebarDisguise",
        "title": "%command.toggleSidebarDisguise%",
        "icon": "$(eye)"
      },
      {
        "command": "book-reader.refreshBookList",
        "title": "%command.refreshBookList%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bookReader",
          "title": "%view.container%",
          "icon": "renderer/public/icon.svg"
        }
      ]
    },
    "views": {
      "bookReader": [
        {
          "id": "bookReaderList",
          "name": "%view.bookList%",
          "icon": "$(home)"
        },
        {
          "id": "bookReaderSidebar",
          "name": "%view.readerSidebar%",
          "icon": "$(book)",
          "type": "webview"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "book-reader.openFile",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.epub"
          },
          {
            "filenamePattern": "*.mobi"
          },
          {
            "filenamePattern": "*.fk8"
          },
          {
            "filenamePattern": "*.azw3"
          },
          {
            "filenamePattern": "*.fb2"
          },
          {
            "filenamePattern": "*.cbz"
          },
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.txt"
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "book-reader.refreshBookList",
          "when": "view == bookReaderList",
          "group": "navigation@1"
        },
        {
          "command": "book-reader.toggleSidebarDisguise",
          "when": "view == bookReaderList",
          "group": "navigation@2"
        },
        {
          "command": "book-reader.selectBookFolder",
          "when": "view == bookReaderList",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "book-reader.openBookInSidebar",
          "when": "view == bookReaderList && viewItem == 'bookItem'",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "book-reader.bookFolderPath": {
          "type": "string",
          "default": "",
          "description": "%configuration.bookFolderPath%"
        },
        "book-reader.sidebarDisguise": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.sidebarDisguise%"
        }
      }
    }
  },
  "scripts": {
    "dev": "pnpm -F ./renderer dev",
    "build": "pnpm compile && pnpm -F ./renderer build",
    "preview": "pnpm -F ./renderer preview",
    "vscode:prepublish": "pnpm compile",
    "package": "pnpm vsce package",
    "compile": "pnpm -F ./renderer exec vite build --config vite.extension.config.ts",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm compile && pnpm lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~18.19.130",
    "@types/vscode": "^1.88.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bing-translate-api": "^4.2.0",
    "node-edge-tts": "1.2.10"
  },
  "vsce": {
    "dependencies": false,
    "useYarn": false
  },
  "packageManager": "pnpm@9.6.0"
}